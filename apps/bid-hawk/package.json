    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.7",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "zustand": "^5.0.1"
