{
  "name": "bidos",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --config vite.config.offline.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "seed:partners": "tsx --env-file=.env.local scripts/seed-partners.ts"
  },
  "dependencies": {
