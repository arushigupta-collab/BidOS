# BidOS — Bid Hawk. Copy to .env.local and fill in. .env.local is gitignored.
#
# THE PREFIX IS THE SECURITY BOUNDARY.
# Vite inlines any VITE_-prefixed variable into the browser bundle as a literal
# string. Anything without the prefix stays server-side, readable only by the
# functions under api/ and by the ingestion CLI.
#
# Never add VITE_ to the two keys below. src/routes/bundleHygiene.test.ts fails
# the build if either reaches a bundle.

# ---- Server only. Never prefixed, never sent to a browser. ----

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Supabase → Project Settings → API → service_role.
# Bypasses every row policy. Only the ingestion pipeline uses it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Client. Safe to ship; both are meant to be public. ----

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Cross-module links. Unset in production. ----
VITE_BID_ORCHESTRATOR_URL=http://localhost:5174/
VITE_BID_AUTHOR_URL=http://localhost:5175/
