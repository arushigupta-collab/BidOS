# Copy to .env.local and fill in. .env.local is gitignored.
#
# This app reads what Bid Hawk extracted; it never runs the ingestion pipeline
# and therefore never needs the OpenRouter key. Keep it out of here: a key that
# exists in one place is a key with one place to leak from.
#
# Vite inlines any VITE_-prefixed variable into the browser bundle. Both below
# are anon-level and meant to be public.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server only, for the /api/ai-fill endpoint. Never prefixed.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Back to the platform. Unset in production. ----
VITE_BIDOS_URL=http://localhost:5173/
