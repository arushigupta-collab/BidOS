# Copy to .env.local inside EACH app under apps/. Gitignored.
#
# THE PREFIX IS THE SECURITY BOUNDARY.
# Vite inlines any VITE_-prefixed variable into the browser bundle as a literal
# string. Anything without the prefix stays server-side, readable only by the
# handlers under api/ and by the ingestion CLI.
#
# Never add VITE_ to the first two. apps/bid-hawk/src/routes/bundleHygiene.test.ts
# fails the build if either reaches a bundle.

# ---- Server only ----------------------------------------------------------

# https://openrouter.ai/keys
# Needed by bid-hawk (the ingestion pipeline) and by the AI endpoints in the
# other two apps.
OPENROUTER_API_KEY=sk-or-v1-...

# Supabase -> Project Settings -> API -> service_role. Bypasses every policy.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Client. Both are anon-level and meant to be public. -------------------

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Cross-module links. Unset in production, where each defaults to the -----
# ---- hosted deployment. Set these to run the three modules locally.     -----

# In apps/bid-hawk only:
VITE_BID_ORCHESTRATOR_URL=http://localhost:5174/
VITE_BID_AUTHOR_URL=http://localhost:5175/

# In apps/bid-orchestrator and apps/bid-author:
VITE_BIDOS_URL=http://localhost:5173/
